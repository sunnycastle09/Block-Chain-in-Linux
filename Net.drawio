        </mxCell>
        <mxCell id="YA8MsTxdN1ofVGaqcYYh-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="처음 시작시 dns노드가 DNS_setting.txt.로부터 맥,지갑 주소 가져옴&amp;nbsp;&lt;div&gt;recv대기중인 node123+User에게 다 전달&lt;/div&gt;&lt;div&gt;이제 User가 거래생성 후 보내기 반복&lt;/div&gt;&lt;div&gt;각 노드는 거래 받음(port2)5개 이상 모이면 PoW&lt;/div&gt;&lt;div&gt;블록 완성 후 들어온 블록 없으면 그대로 전파(port 3)&lt;/div&gt;" vertex="1">
          <mxGeometry height="121" width="240" x="600" y="-290" as="geometry" />
        </mxCell>
        <mxCell id="YA8MsTxdN1ofVGaqcYYh-31" edge="1" parent="1" source="YA8MsTxdN1ofVGaqcYYh-27" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="YA8MsTxdN1ofVGaqcYYh-30" value="">
