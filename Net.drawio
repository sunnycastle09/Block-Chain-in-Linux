        <mxCell id="YA8MsTxdN1ofVGaqcYYh-32" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="veth_gw4" vertex="1">
          <mxGeometry height="20" width="60" x="371" as="geometry" />
        </mxCell>
        <mxCell id="r2Q68Symml1Qycj_yvNC-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;UTXO 형식&lt;/div&gt;&lt;div&gt;(수신자 주소. 값, UTXO ID,개인키서명) (ID는 주소+값 해시값으로)&lt;/div&gt;&lt;div&gt;이 형식으로 클래스 밑 UTXO set만듬&lt;/div&gt;&lt;div&gt;유저가 전달하는 거래형식&lt;/div&gt;&lt;div&gt;input(수신자 주소. 값, UTXO ID,개인키서명,공개키)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;output(수신자 주소. 값, UTXO ID,개인키서명)&lt;/div&gt;&lt;div&gt;,수수료(채굴자 주소,값,UTXO ID,개인키서명)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;인증은 개인키 서명을 공개키로 푸는것으로 인증&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;sha256(수신자주소+값) 으로 UTXO ID&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="341" x="30" y="-350" as="geometry" />
        </mxCell>
        <mxCell id="r2Q68Symml1Qycj_yvNC-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;1~3은 node1~3&amp;nbsp;&lt;/div&gt;&lt;div&gt;4는 User&lt;/div&gt;addr1~4&lt;div&gt;prv1~4&lt;/div&gt;&lt;div&gt;pub1~4&lt;/div&gt;&lt;div&gt;sig1~4&lt;/div&gt;&lt;div&gt;(prv으로만듬)&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="160" x="390" y="-380" as="geometry" />
