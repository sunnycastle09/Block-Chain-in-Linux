        <mxCell id="YA8MsTxdN1ofVGaqcYYh-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="노드 내부&amp;nbsp;" vertex="1">
