        <mxCell id="YA8MsTxdN1ofVGaqcYYh-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="거래 인증 조건을 AI프롬프트 식으로 할것임. 상대방의 공개키 지정없이 AI질문의 대답을 만족시키면 해당 UTXO를 사용가능 함." vertex="1">
