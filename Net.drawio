        </mxCell>
        <mxCell id="YA8MsTxdN1ofVGaqcYYh-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="ISP는 거래생성 시 자동으로 노드에게 전달" vertex="1">
          <mxGeometry height="40" width="90" x="438" y="90" as="geometry" />
        </mxCell>
        <mxCell id="YA8MsTxdN1ofVGaqcYYh-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="inputs랑 ouputs는 TXip 과 TXOp heap생성 객체를 배열로 하는 벡터&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="140" x="900" y="620" as="geometry" />
        </mxCell>
        <mxCell id="YA8MsTxdN1ofVGaqcYYh-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="거래기록은 Transaction형 2차원 벡터. 1차 인덱스는 블록 높이를 의미. 2차 인덱스에 각 인덱스마다 거래저장.&lt;div&gt;vector &amp;lt;vector&amp;lt;Transaction&amp;gt;&amp;gt; TX_log&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;블록체인 상태는 각 블록의 해시로 구분.&lt;/div&gt;&lt;div&gt;1블록해시-2블록해서 연결로 분기점 찾아내기도 가능&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;vector&amp;nbsp; &amp;lt;string&amp;gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Block_chain&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="210" x="1010" y="390" as="geometry" />
        </mxCell>
        <mxCell id="YA8MsTxdN1ofVGaqcYYh-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="일단 노드가 전달 받는 데이터는 그저 문자열 연속 이걸 memory_pool에 저장&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;그 문자열을 TX_log에 현재블록높이에 맞는 인덱스에 생성자로 선언&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;거래 기록이 3개 이상 모이면&amp;nbsp;&lt;/div&gt;&lt;div&gt;작업증명시작&lt;/div&gt;&lt;div&gt;이건 미리만들어둔거 참고&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;찾았을 시 블록전파(헤더,바디(거래기록))&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="210" x="318" y="474" as="geometry" />
        </mxCell>
